# ==============================================================================
# SYSWATCH Environment Configuration (.env)
# ==============================================================================

# Ports exposed on the host machine
SYSWATCH_BACKEND_PORT=8000
SYSWATCH_DASHBOARD_PORT=3000

# SQLite Database path inside backend container (persisted via Docker volume)
DATABASE_PATH=/app/data/telemetry.db
SYSWATCH_DB_PATH=/app/data/telemetry.db

# Telemetry Agent collection interval in seconds
COLLECTION_INTERVAL=3.0
SYSWATCH_INTERVAL=3.0

# Backend URL used by the Agent container inside the Docker network
BACKEND_URL=http://backend:8000
SYSWATCH_BACKEND_URL=http://backend:8000

# Logging severity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
