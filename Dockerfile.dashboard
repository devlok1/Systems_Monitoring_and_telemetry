# ==============================================================================
# SYSWATCH Dashboard Dockerfile (Multi-Stage Production Build)
# ==============================================================================

# Stage 1: Build React / TypeScript assets with Node.js
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies using package-lock.json
COPY dashboard/package.json dashboard/package-lock.json ./
RUN npm ci

# Copy dashboard source
COPY dashboard/ ./

# Empty VITE_API_URL produces relative URLs (/health, /telemetry/latest)
# which are handled seamlessly by the Nginx reverse proxy
ENV VITE_API_URL=""
RUN npm run build

# Stage 2: Serve production bundle with Nginx reverse proxy
FROM nginx:alpine

# Replace default Nginx configuration
RUN rm -rf /etc/nginx/conf.d/default.conf
COPY dashboard/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
