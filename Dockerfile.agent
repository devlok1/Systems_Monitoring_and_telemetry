# SYSWATCH Telemetry Agent Dockerfile
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    SYSWATCH_BACKEND_URL=http://backend:8000 \
    SYSWATCH_INTERVAL=3.0

WORKDIR /app

# Install build dependencies in case psutil wheel compilation is required
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

COPY agent/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create non-root runner user
RUN useradd -m -u 1002 agentuser

COPY --chown=agentuser:agentuser agent /app/agent

USER agentuser

CMD ["python", "-m", "agent.agent"]
